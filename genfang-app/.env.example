# Kopiér til .env.local (lokalt) eller sæt i Vercel → Settings → Environment Variables.
# ALDRIG Claude-, Supabase service-role- eller Stripe-nøgler i NEXT_PUBLIC_*-variabler.

# Mindst 32 tilfældige tegn. Generér: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Adgangskode til de syntetiske testkonti (kun testversion).
DEMO_PASSWORD=

# Valgfri: offentlig VAPID-nøgle til web push. Den private nøgle må kun ligge server-side.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
