{
  "name": "genfang-app",
  "version": "0.1.0",
  "private": true,
  "description": "GENFANG \u2013 mobil kundeplatform (PWA-testversion med syntetiske data)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/unit/*.test.ts",
    "test:e2e": "node test/e2e/mobile.e2e.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test:db": "node --experimental-strip-types --test test/db/*.test.ts"
  },
  "dependencies": {
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "5.9"
  }
}